generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum PlanoTipo {
  BASICO
  PROFISSIONAL
  ENTERPRISE
}

enum StatusEmpresa {
  ATIVA
  SUSPENSA
  CANCELADA
}

// ─── MULTIEMPRESA ─────────────────────────────────────────────────────────────

model Empresa {
  id            String        @id @default(cuid())
  nome          String
  slug          String        @unique
  cnpj          String?       @unique
  logo_url      String?
  plano         PlanoTipo     @default(BASICO)
  status        StatusEmpresa @default(ATIVA)
  configuracoes  Json          @default("{}")
  asaas_api_key  String?
  criado_em      DateTime      @default(now())
  atualizado_em DateTime      @updatedAt

  membros    MembroEmpresa[]
  perfis     Perfil[]
  convites   ConviteEmpresa[]
  convites_cliente ConviteCliente[]
  clientes   Cliente[]
  servicos   Servico[]
  leads      Lead[]
  propostas  Proposta[]
  contratos  Contrato[]
  projetos         Projeto[]
  documentos       Documento[]
  pastas_documento PastaDocumento[]
  plano_contas     PlanoDeContas[]
  contas_bancarias ContaBancaria[]
  transferencias_tesouraria TransferenciaTesouraria[]
  boletos              Boleto[]
  recebiveis           Recebivel[]
  contas_pagar         ContaPagar[]
  fornecedores         Fornecedor[]
  modelos_documento    ModeloDocumento[]
  eventos              Evento[]
  registros_auditoria  RegistroAuditoria[]
  notificacoes         Notificacao[]
  notas_fiscais        NotaFiscal[]
  diagnosticos         Diagnostico[]
  etiquetas_tarefa     EtiquetaTarefa[]
  aplicacoes_diagnostico AplicacaoDiagnostico[]
  etapas_crm           EtapaCrm[]
  campanhas_diagnostico CampanhaDiagnostico[]
  centros_custo        CentroCusto[]
  diagnostico_templates DiagnosticoTemplate[]
  assinaturas          Assinatura[]
  campanhas_cupom      CampanhaCupom[]

  @@map("empresas")
}

// ─── USUÁRIOS (espelha auth.users do Supabase) ────────────────────────────────

model Usuario {
  id            String   @id // igual ao auth.users.id
  nome          String
  email         String   @unique
  avatar_url    String?
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  membros           MembroEmpresa[]
  convites          ConviteEmpresa[]
  leads             Lead[]
  comentarios_crm   ComentarioCrm[]
  propostas_criadas Proposta[]
  contratos_criados Contrato[]
  projetos_criados    Projeto[]
  tarefas             Tarefa[]
  documentos_criados  Documento[]
  recebiveis_criados  Recebivel[]  @relation("RecebiveisCriados")
  contas_pagar_criadas ContaPagar[] @relation("ContasPagarCriadas")
  eventos_responsavel    Evento[]     @relation("EventosResponsavel")
  propostas_responsavel  Proposta[]   @relation("PropostasResponsavel")
  contratos_responsavel  Contrato[]   @relation("ContratosResponsavel")
  convites_cliente       ConviteCliente[]
  comentarios_tarefa     ComentarioTarefa[]
  anexos_tarefa          AnexoTarefa[]
  atividades_tarefa      AtividadeTarefa[]
  aprovacoes_solicitadas AprovacaoTarefa[]  @relation("AprovacaoSolicitante")
  aprovacoes_recebidas   AprovacaoTarefa[]  @relation("AprovacaoAprovador")
  tarefas_responsavel    TarefaResponsavel[]

  @@map("usuarios")
}

// ─── MEMBRO: relação usuário ↔ empresa ───────────────────────────────────────

model MembroEmpresa {
  id         String   @id @default(cuid())
  usuario_id String
  empresa_id String
  perfil_id  String
  ativo      Boolean  @default(true)
  criado_em  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfil_id], references: [id])

  @@unique([usuario_id, empresa_id])
  @@map("membros_empresa")
}

// ─── RBAC: PERFIS ─────────────────────────────────────────────────────────────

model Perfil {
  id         String   @id @default(cuid())
  empresa_id String?  // null = perfil padrão do sistema (não editável)
  nome       String
  descricao  String?
  sistema    Boolean  @default(false)
  criado_em  DateTime @default(now())

  empresa    Empresa?        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  membros    MembroEmpresa[]
  permissoes PerfilPermissao[]

  @@unique([empresa_id, nome])
  @@map("perfis")
}

// ─── RBAC: PERMISSÕES ─────────────────────────────────────────────────────────

model Permissao {
  id        String  @id @default(cuid())
  recurso   String  // ex: "clientes", "propostas", "contratos"
  acao      String  // ex: "ver", "criar", "editar", "excluir"
  descricao String?

  perfis PerfilPermissao[]

  @@unique([recurso, acao])
  @@map("permissoes")
}

// ─── RBAC: PERFIL ↔ PERMISSÃO ────────────────────────────────────────────────

model PerfilPermissao {
  perfil_id    String
  permissao_id String

  perfil    Perfil    @relation(fields: [perfil_id], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissao_id], references: [id], onDelete: Cascade)

  @@id([perfil_id, permissao_id])
  @@map("perfis_permissoes")
}

// ─── CONVITE DE USUÁRIO ───────────────────────────────────────────────────────

model ConviteEmpresa {
  id            String    @id @default(cuid())
  empresa_id    String
  email         String
  perfil_id     String
  token         String    @unique @default(cuid())
  convidado_por String?
  aceito_em     DateTime?
  expira_em     DateTime
  criado_em     DateTime  @default(now())

  empresa   Empresa  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  convidado Usuario? @relation(fields: [convidado_por], references: [id])

  @@map("convites_empresa")
}

model ConviteCliente {
  id         String    @id @default(cuid())
  empresa_id String
  token      String    @unique @default(cuid())
  criado_por String?
  usado_em   DateTime?
  cliente_id String?   @unique
  expira_em  DateTime?
  criado_em  DateTime  @default(now())

  empresa  Empresa  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  criador  Usuario? @relation(fields: [criado_por], references: [id])
  cliente  Cliente? @relation(fields: [cliente_id], references: [id])

  @@map("convites_cliente")
}

// ─── FASE 1: ENUMS ────────────────────────────────────────────────────────────

enum TipoCliente {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum StatusCliente {
  ATIVO
  INATIVO
  PROSPECT
}

enum StatusProposta {
  RASCUNHO
  ENVIADA
  VISUALIZADA
  ACEITA
  RECUSADA
  EXPIRADA
}

enum StatusContrato {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

// ─── CLIENTES ─────────────────────────────────────────────────────────────────

model Cliente {
  id                 String        @id @default(cuid())
  empresa_id         String
  nome               String
  tipo               TipoCliente   @default(PESSOA_JURIDICA)
  nome_fantasia      String?
  cpf_cnpj           String?
  inscricao_estadual String?
  contato_principal  String?
  email              String?
  telefone           String?
  whatsapp           String?
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  nome_fazenda       String?
  distancia_km       Decimal?      @db.Decimal(8, 2)
  preco_km           Decimal?      @db.Decimal(8, 2)
  status             StatusCliente @default(ATIVO)
  asaas_id           String?
  criado_em          DateTime      @default(now())
  atualizado_em      DateTime      @updatedAt

  empresa       Empresa       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  contatos      Contato[]
  leads         Lead[]
  propostas     Proposta[]
  contratos     Contrato[]
  projetos      Projeto[]
  tokens_portal TokenPortal[]
  recebiveis    Recebivel[]
  boletos       Boleto[]
  eventos       Evento[]
  notas_fiscais NotaFiscal[]
  diagnosticos  Diagnostico[]
  convite       ConviteCliente?
  documentos    Documento[]
  aplicacoes_diagnostico AplicacaoDiagnostico[]
  assinaturas   Assinatura[]

  @@map("clientes")
}

model Contato {
  id         String   @id @default(cuid())
  cliente_id String
  nome       String
  cargo      String?
  email      String?
  telefone   String?
  principal  Boolean  @default(false)
  criado_em  DateTime @default(now())

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@map("contatos")
}

// ─── SERVIÇOS ─────────────────────────────────────────────────────────────────

model Servico {
  id                   String   @id @default(cuid())
  empresa_id           String
  plano_contas_id      String?
  nome                 String
  descricao            String?
  valor_base           Decimal? @db.Decimal(10, 2)
  ativo                Boolean  @default(true)
  canal                String?  // ARATO | CONSELHO_AGRO | CONSULTORIA
  plano                String?  // ESSENCIAL | GESTAO | PERFORMANCE | NOVO_AGRO | MESA_AGRO | CONSULTORIA_AGRO
  tipo_cobranca        String?  // ASSINATURA | PROJETO | PONTUAL
  asaas_link_pagamento String?
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  empresa        Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  plano_contas   PlanoDeContas? @relation(fields: [plano_contas_id], references: [id], onDelete: SetNull)
  itens_proposta ItemProposta[]
  leads          Lead[]
  assinaturas    Assinatura[]
  campanhas_cupom CampanhaCupom[]

  @@map("servicos")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model EtapaCrm {
  id         String   @id @default(cuid())
  empresa_id String
  chave      String
  nome       String
  cor        String   @default("#1B4F72")
  ordem      Int      @default(0)
  criado_em  DateTime @default(now())

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@unique([empresa_id, chave])
  @@map("etapas_crm")
}

model ComentarioCrm {
  id         String   @id @default(cuid())
  lead_id    String
  usuario_id String?
  autor_nome String
  mensagem   String
  criado_em  DateTime @default(now())

  lead    Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@map("comentarios_crm")
}

model Lead {
  id                  String    @id @default(cuid())
  empresa_id          String
  cliente_id          String?
  responsavel_id      String?
  servico_id          String?
  etapa_id            String?
  nome                String
  empresa_nome        String?
  contato_nome        String?
  email               String?
  telefone            String?
  whatsapp            String?
  etapa_chave         String    @default("NOVO")
  valor_estimado      Decimal?  @db.Decimal(10, 2)
  probabilidade       Int       @default(10)
  previsao_fechamento DateTime?
  proxima_acao        String?
  data_proxima_acao   DateTime?
  origem              String?
  observacoes         String?
  motivo_perda        String?
  tags                String[]  @default([])
  criado_em           DateTime  @default(now())
  atualizado_em       DateTime  @updatedAt

  empresa     Empresa         @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  cliente     Cliente?        @relation(fields: [cliente_id], references: [id])
  responsavel Usuario?        @relation(fields: [responsavel_id], references: [id])
  servico     Servico?        @relation(fields: [servico_id], references: [id])
  etapa       EtapaCrm?       @relation(fields: [etapa_id], references: [id])
  comentarios             ComentarioCrm[]
  propostas               Proposta[]
  diagnostico_participante DiagnosticoParticipante?

  @@map("leads")
}

// ─── PROPOSTAS ────────────────────────────────────────────────────────────────

model Proposta {
  id                  String         @id @default(cuid())
  empresa_id          String
  cliente_id          String
  lead_id             String?
  criado_por          String?
  responsavel_id      String?
  titulo              String
  objeto              String?
  status              StatusProposta @default(RASCUNHO)
  token_aceite        String         @unique @default(cuid())
  introducao          String?
  condicoes           String?
  valor_total         Decimal        @db.Decimal(10, 2) @default(0)
  forma_pagamento     String?
  periodicidade       String?
  numero_parcelas     Int?
  primeiro_vencimento DateTime?
  validade            DateTime?
  contato_nome        String?
  contato_email       String?
  contato_telefone    String?
  parcelas_json       Json?
  enviado_em          DateTime?
  visualizado_em      DateTime?
  aceito_em           DateTime?
  recusado_em         DateTime?
  criado_em           DateTime       @default(now())
  atualizado_em       DateTime       @updatedAt

  empresa      Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  cliente      Cliente        @relation(fields: [cliente_id], references: [id])
  lead         Lead?          @relation(fields: [lead_id], references: [id])
  criador      Usuario?       @relation(fields: [criado_por], references: [id])
  responsavel  Usuario?       @relation("PropostasResponsavel", fields: [responsavel_id], references: [id])
  itens        ItemProposta[]
  contrato     Contrato?
  aceite_otps  AceiteOtp[]

  @@map("propostas")
}

model AceiteOtp {
  id          String   @id @default(cuid())
  proposta_id String
  codigo      String
  email       String
  expira_em   DateTime
  tentativas  Int      @default(0)
  criado_em   DateTime @default(now())

  proposta Proposta @relation(fields: [proposta_id], references: [id], onDelete: Cascade)

  @@map("aceite_otp")
}

model ItemProposta {
  id             String  @id @default(cuid())
  proposta_id    String
  servico_id     String?
  descricao      String
  quantidade     Decimal @db.Decimal(10, 3) @default(1)
  valor_unitario Decimal @db.Decimal(10, 2)
  desconto       Decimal @db.Decimal(5, 2) @default(0)
  ordem          Int     @default(0)

  proposta Proposta @relation(fields: [proposta_id], references: [id], onDelete: Cascade)
  servico  Servico? @relation(fields: [servico_id], references: [id])

  @@map("itens_proposta")
}

// ─── CONTRATOS ────────────────────────────────────────────────────────────────

model Contrato {
  id                    String         @id @default(cuid())
  empresa_id            String
  proposta_id           String?        @unique
  cliente_id            String
  criado_por            String?
  responsavel_id        String?
  numero_contrato       String?
  tipo_contrato         String?
  titulo                String
  objeto                String?
  status                StatusContrato @default(RASCUNHO)
  conteudo              String?
  valor_total           Decimal        @db.Decimal(10, 2) @default(0)
  forma_pagamento       String?
  periodicidade         String?
  numero_parcelas       Int?
  primeiro_vencimento   DateTime?
  dia_vencimento        Int?
  parcelas_json         Json?
  indice_reajuste       String?
  periodicidade_reajuste String?
  renovacao_automatica  Boolean        @default(false)
  gerar_projeto         Boolean        @default(false)
  gerar_financeiro      Boolean        @default(true)
  cliente_nome          String?
  cliente_cpf_cnpj      String?
  cliente_contato_nome  String?
  cliente_contato_email String?
  cliente_contato_tel   String?
  data_emissao          DateTime?
  data_inicio           DateTime?
  data_fim              DateTime?
  assinado_em           DateTime?
  anexo_url             String?
  authentique_id        String?
  authentique_url       String?
  pdf_assinado_url      String?
  juros_ao_mes_percentual Decimal?     @db.Decimal(5, 2)
  multa_percentual        Decimal?     @db.Decimal(5, 2)
  criado_em             DateTime       @default(now())
  atualizado_em         DateTime       @updatedAt

  empresa     Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  proposta    Proposta? @relation(fields: [proposta_id], references: [id])
  cliente     Cliente   @relation(fields: [cliente_id], references: [id])
  criador     Usuario?  @relation(fields: [criado_por], references: [id])
  responsavel Usuario?  @relation("ContratosResponsavel", fields: [responsavel_id], references: [id])
  projeto       Projeto?
  recebiveis    Recebivel[]
  eventos       Evento[]
  notas_fiscais NotaFiscal[]
  documentos    Documento[]

  @@map("contratos")
}

// ─── FASE 2: ENUMS ────────────────────────────────────────────────────────────

enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum PrioridadeTarefa {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusAprovacao {
  PENDENTE
  APROVADO
  REPROVADO
}

enum CategoriaDocumento {
  CONTRATO
  PROPOSTA
  PROJETO
  FINANCEIRO
  INTERNO
  OUTROS
}

// ─── PROJETOS ─────────────────────────────────────────────────────────────────

model Projeto {
  id            String        @id @default(cuid())
  empresa_id    String
  contrato_id   String?       @unique
  cliente_id    String?
  interno            Boolean       @default(false)
  criado_por         String?
  titulo             String
  descricao          String?
  status             StatusProjeto @default(PLANEJAMENTO)
  data_inicio        DateTime?
  data_fim           DateTime?
  e_centro_custo     Boolean       @default(false)
  criado_em          DateTime      @default(now())
  atualizado_em      DateTime      @updatedAt

  empresa      Empresa      @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  contrato     Contrato?    @relation(fields: [contrato_id], references: [id])
  cliente      Cliente?     @relation(fields: [cliente_id], references: [id])
  criador      Usuario?     @relation(fields: [criado_por], references: [id])
  etapas       Etapa[]
  tarefas      Tarefa[]
  documentos   Documento[]
  eventos      Evento[]
  diagnosticos Diagnostico[]
  aplicacoes_diagnostico AplicacaoDiagnostico[]
  centro_custo CentroCusto?

  @@map("projetos")
}

model Etapa {
  id            String      @id @default(cuid())
  projeto_id    String
  titulo        String
  descricao     String?
  status        StatusEtapa @default(PENDENTE)
  ordem         Int         @default(0)
  data_inicio   DateTime?
  data_fim      DateTime?
  criado_em     DateTime    @default(now())
  atualizado_em DateTime    @updatedAt

  projeto Projeto  @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  tarefas Tarefa[]

  @@map("etapas")
}

model Tarefa {
  id             String           @id @default(cuid())
  etapa_id       String
  projeto_id     String
  responsavel_id String?
  titulo         String
  descricao      String?
  status         StatusTarefa     @default(PENDENTE)
  prioridade     PrioridadeTarefa @default(MEDIA)
  ordem          Int              @default(0)
  data_prazo     DateTime?
  concluida_em   DateTime?
  criado_em      DateTime         @default(now())
  atualizado_em  DateTime         @updatedAt

  etapa       Etapa    @relation(fields: [etapa_id], references: [id], onDelete: Cascade)
  projeto     Projeto  @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  responsavel Usuario? @relation(fields: [responsavel_id], references: [id])

  comentarios  ComentarioTarefa[]
  anexos       AnexoTarefa[]
  atividades   AtividadeTarefa[]
  aprovacoes   AprovacaoTarefa[]
  checklist    ItemChecklist[]
  etiquetas    TarefaEtiqueta[]
  responsaveis TarefaResponsavel[]

  @@map("tarefas")
}

model TarefaResponsavel {
  tarefa_id  String
  usuario_id String

  tarefa  Tarefa  @relation(fields: [tarefa_id],  references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([tarefa_id, usuario_id])
  @@map("tarefas_responsaveis")
}

model ComentarioTarefa {
  id            String   @id @default(cuid())
  tarefa_id     String
  autor_id      String?
  conteudo      String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tarefa Tarefa   @relation(fields: [tarefa_id], references: [id], onDelete: Cascade)
  autor  Usuario? @relation(fields: [autor_id], references: [id])

  @@map("comentarios_tarefa")
}

model AnexoTarefa {
  id              String   @id @default(cuid())
  tarefa_id       String
  criado_por      String?
  nome            String
  arquivo_url     String
  arquivo_tamanho Int      @default(0)
  mime_type       String   @default("application/octet-stream")
  criado_em       DateTime @default(now())

  tarefa  Tarefa   @relation(fields: [tarefa_id], references: [id], onDelete: Cascade)
  criador Usuario? @relation(fields: [criado_por], references: [id])

  @@map("anexos_tarefa")
}

model AtividadeTarefa {
  id        String   @id @default(cuid())
  tarefa_id String
  autor_id  String?
  descricao String
  criado_em DateTime @default(now())

  tarefa Tarefa   @relation(fields: [tarefa_id], references: [id], onDelete: Cascade)
  autor  Usuario? @relation(fields: [autor_id], references: [id])

  @@map("atividades_tarefa")
}

model AprovacaoTarefa {
  id            String          @id @default(cuid())
  tarefa_id     String
  solicitante_id String?
  aprovador_id  String?
  status        StatusAprovacao @default(PENDENTE)
  comentario    String?
  criado_em     DateTime        @default(now())
  decidido_em   DateTime?

  tarefa      Tarefa   @relation(fields: [tarefa_id], references: [id], onDelete: Cascade)
  solicitante Usuario? @relation("AprovacaoSolicitante", fields: [solicitante_id], references: [id])
  aprovador   Usuario? @relation("AprovacaoAprovador",   fields: [aprovador_id],   references: [id])

  @@map("aprovacoes_tarefa")
}

model ItemChecklist {
  id        String   @id @default(cuid())
  tarefa_id String
  texto     String
  concluido Boolean  @default(false)
  ordem     Int      @default(0)
  criado_em DateTime @default(now())

  tarefa Tarefa @relation(fields: [tarefa_id], references: [id], onDelete: Cascade)

  @@map("checklist_tarefa")
}

model EtiquetaTarefa {
  id         String @id @default(cuid())
  empresa_id String
  nome       String
  cor        String @default("#64748B")

  empresa  Empresa          @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  tarefas  TarefaEtiqueta[]

  @@map("etiquetas_tarefa")
}

model TarefaEtiqueta {
  tarefa_id   String
  etiqueta_id String

  tarefa   Tarefa         @relation(fields: [tarefa_id],   references: [id], onDelete: Cascade)
  etiqueta EtiquetaTarefa @relation(fields: [etiqueta_id], references: [id], onDelete: Cascade)

  @@id([tarefa_id, etiqueta_id])
  @@map("tarefas_etiquetas")
}

// ─── DOCUMENTOS ───────────────────────────────────────────────────────────────

model PastaDocumento {
  id            String   @id @default(cuid())
  empresa_id    String
  nome          String
  descricao     String?
  parent_id     String?
  criado_por    String?
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  empresa    Empresa          @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  parent     PastaDocumento?  @relation("PastaHierarquia", fields: [parent_id], references: [id], onDelete: Cascade)
  filhos     PastaDocumento[] @relation("PastaHierarquia")
  documentos Documento[]

  @@map("pastas_documento")
}

model Documento {
  id              String             @id @default(cuid())
  empresa_id      String
  projeto_id      String?
  cliente_id      String?
  contrato_id     String?
  pasta_id        String?
  criado_por      String?
  titulo          String
  descricao       String?
  categoria       CategoriaDocumento @default(INTERNO)
  arquivo_url     String
  arquivo_nome    String
  arquivo_tamanho Int                @default(0)
  mime_type       String             @default("application/octet-stream")
  criado_em       DateTime           @default(now())

  empresa   Empresa         @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  projeto   Projeto?        @relation(fields: [projeto_id],  references: [id])
  cliente   Cliente?        @relation(fields: [cliente_id],  references: [id])
  contrato  Contrato?       @relation(fields: [contrato_id], references: [id])
  pasta     PastaDocumento? @relation(fields: [pasta_id],    references: [id])
  criador   Usuario?        @relation(fields: [criado_por],  references: [id])

  @@map("documentos")
}

// ─── FASE 3: ENUMS ────────────────────────────────────────────────────────────

enum TipoConta {
  CORRENTE
  POUPANCA
  CAIXA
  INVESTIMENTO
}

enum StatusRecebivel {
  PENDENTE
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
  RENEGOCIADO
}

enum StatusContaPagar {
  PENDENTE
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoPlanoContas {
  RECEITA
  CUSTO
  DESPESA
  INVESTIMENTO
  TESOURARIA
}

// ─── PLANO DE CONTAS ──────────────────────────────────────────────────────────

model PlanoDeContas {
  id                String          @id @default(cuid())
  empresa_id        String
  parent_id         String?
  nome              String
  tipo              TipoPlanoContas
  codigo            String?
  aceita_lancamento Boolean         @default(true)
  ativo             Boolean         @default(true)
  criado_em         DateTime        @default(now())

  empresa      Empresa         @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  parent       PlanoDeContas?  @relation("PlanoHierarquia", fields: [parent_id], references: [id])
  filhos       PlanoDeContas[] @relation("PlanoHierarquia")
  recebiveis   Recebivel[]
  contas_pagar ContaPagar[]
  servicos     Servico[]

  @@map("plano_de_contas")
}

// ─── BANCOS ───────────────────────────────────────────────────────────────────

model Banco {
  id     String @id @default(cuid())
  codigo String @unique
  nome   String
  sigla  String

  contas_bancarias ContaBancaria[]

  @@map("bancos")
}

// ─── CONTAS BANCÁRIAS ─────────────────────────────────────────────────────────

model ContaBancaria {
  id            String    @id @default(cuid())
  empresa_id    String
  nome          String
  banco_id      String?
  banco         String?
  agencia       String?
  conta         String?
  digito        String?
  pix_chave     String?
  tipo          TipoConta @default(CORRENTE)
  saldo_inicial Decimal   @db.Decimal(12, 2) @default(0)
  ativo         Boolean   @default(true)
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  empresa      Empresa      @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  banco_ref    Banco?       @relation(fields: [banco_id], references: [id])
  recebiveis   Recebivel[]
  contas_pagar ContaPagar[]
  transferencias_origem  TransferenciaTesouraria[] @relation("TransferenciaOrigem")
  transferencias_destino TransferenciaTesouraria[] @relation("TransferenciaDestino")

  @@map("contas_bancarias")
}

model TransferenciaTesouraria {
  id               String   @id @default(cuid())
  empresa_id       String
  conta_origem_id  String
  conta_destino_id String
  valor            Decimal  @db.Decimal(12, 2)
  data             DateTime
  descricao        String?
  criado_em        DateTime @default(now())

  empresa       Empresa       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  conta_origem  ContaBancaria @relation("TransferenciaOrigem",  fields: [conta_origem_id],  references: [id])
  conta_destino ContaBancaria @relation("TransferenciaDestino", fields: [conta_destino_id], references: [id])

  @@map("transferencias_tesouraria")
}

// ─── CENTROS DE CUSTO ────────────────────────────────────────────────────────

model CentroCusto {
  id            String   @id @default(cuid())
  empresa_id    String
  nome          String
  codigo        String?
  descricao     String?
  ativo         Boolean  @default(true)
  projeto_id    String?  @unique
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  empresa      Empresa      @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  projeto      Projeto?     @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  recebiveis   Recebivel[]
  contas_pagar ContaPagar[]

  @@map("centros_custo")
}

// ─── RECEBÍVEIS ───────────────────────────────────────────────────────────────

model Recebivel {
  id               String          @id @default(cuid())
  empresa_id       String
  cliente_id       String?
  contrato_id      String?
  plano_contas_id  String?
  conta_bancaria_id String?
  criado_por       String?
  descricao        String
  valor            Decimal         @db.Decimal(10, 2)
  data_vencimento  DateTime
  status           StatusRecebivel @default(PENDENTE)
  data_pagamento   DateTime?
  valor_pago       Decimal?        @db.Decimal(10, 2)
  forma_pagamento  String?
  numero_parcela   Int?
  total_parcelas   Int?
  observacoes      String?
  juros_valor      Decimal?        @db.Decimal(10, 2)
  multa_valor      Decimal?        @db.Decimal(10, 2)
  desconto_valor   Decimal?        @db.Decimal(10, 2)
  recebivel_origem_id  String?
  centro_custo_id      String?
  asaas_payment_id     String?
  asaas_invoice_url    String?
  asaas_pix_copia_cola String?
  asaas_boleto_url     String?
  asaas_status         String?
  criado_em            DateTime        @default(now())
  atualizado_em        DateTime        @updatedAt

  empresa        Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  cliente        Cliente?       @relation(fields: [cliente_id], references: [id])
  contrato       Contrato?      @relation(fields: [contrato_id], references: [id])
  plano_contas   PlanoDeContas? @relation(fields: [plano_contas_id], references: [id])
  conta_bancaria ContaBancaria? @relation(fields: [conta_bancaria_id], references: [id])
  criador        Usuario?       @relation("RecebiveisCriados", fields: [criado_por], references: [id])
  centro_custo   CentroCusto?   @relation(fields: [centro_custo_id], references: [id])
  boleto         Boleto?
  nota_fiscal    NotaFiscal?

  @@map("recebiveis")
}

// ─── CONTAS A PAGAR ───────────────────────────────────────────────────────────

model ContaPagar {
  id                String           @id @default(cuid())
  empresa_id        String
  plano_contas_id   String?
  conta_bancaria_id String?
  fornecedor_id     String?
  criado_por        String?
  descricao         String
  fornecedor        String?
  valor             Decimal          @db.Decimal(10, 2)
  data_vencimento   DateTime
  status            StatusContaPagar @default(PENDENTE)
  data_pagamento    DateTime?
  valor_pago        Decimal?         @db.Decimal(10, 2)
  forma_pagamento   String?
  observacoes       String?
  centro_custo_id   String?
  criado_em         DateTime         @default(now())
  atualizado_em     DateTime         @updatedAt

  empresa           Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  plano_contas      PlanoDeContas? @relation(fields: [plano_contas_id], references: [id])
  conta_bancaria    ContaBancaria? @relation(fields: [conta_bancaria_id], references: [id])
  criador           Usuario?       @relation("ContasPagarCriadas", fields: [criado_por], references: [id])
  centro_custo      CentroCusto?   @relation(fields: [centro_custo_id], references: [id])
  fornecedor_rel    Fornecedor?    @relation(fields: [fornecedor_id], references: [id])

  @@map("contas_pagar")
}

// ─── FORNECEDORES ─────────────────────────────────────────────────────────────

model Fornecedor {
  id              String   @id @default(cuid())
  empresa_id      String
  nome            String
  cnpj_cpf        String?
  email           String?
  telefone        String?
  whatsapp        String?
  // Contato
  nome_contato    String?
  cargo_contato   String?
  // Endereço
  cep             String?
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  // Dados bancários
  banco           String?
  agencia         String?
  conta           String?
  tipo_conta      String?
  // Pix
  chave_pix       String?
  tipo_chave_pix  String?
  // Geral
  observacoes     String?
  ativo           Boolean  @default(true)
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @updatedAt

  empresa      Empresa      @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  contas_pagar ContaPagar[]

  @@map("fornecedores")
}

// ─── FASE 4: ENUMS ────────────────────────────────────────────────────────────

enum TipoModelo {
  CONTRATO
  PROPOSTA
  RECIBO
  GENERICO
}

// ─── MODELOS DE DOCUMENTO ─────────────────────────────────────────────────────

model ModeloDocumento {
  id            String     @id @default(cuid())
  empresa_id    String
  nome          String
  tipo          TipoModelo
  conteudo      String     @default("")
  ativo         Boolean    @default(true)
  criado_em     DateTime   @default(now())
  atualizado_em DateTime   @updatedAt

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@map("modelos_documento")
}

// ─── FASE 5: AGENDA ───────────────────────────────────────────────────────────

model Evento {
  id               String    @id @default(cuid())
  empresa_id       String
  responsavel_id   String?
  cliente_id       String?
  contrato_id      String?
  projeto_id       String?
  titulo           String
  descricao        String?
  inicio           DateTime
  fim              DateTime?
  dia_todo         Boolean   @default(false)
  lembrete_minutos Int?
  lembrete_em      DateTime?
  lembrete_enviado Boolean   @default(false)
  criado_em        DateTime  @default(now())
  atualizado_em    DateTime  @updatedAt

  empresa     Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  responsavel Usuario?  @relation("EventosResponsavel", fields: [responsavel_id], references: [id])
  cliente     Cliente?  @relation(fields: [cliente_id], references: [id])
  contrato    Contrato? @relation(fields: [contrato_id], references: [id])
  projeto     Projeto?  @relation(fields: [projeto_id], references: [id])

  @@map("eventos")
}

// ─── FASE 5: AUDITORIA ────────────────────────────────────────────────────────

model RegistroAuditoria {
  id           String   @id @default(cuid())
  empresa_id   String
  usuario_id   String?
  usuario_nome String?
  recurso      String
  acao         String
  registro_id  String?
  detalhes     Json?
  criado_em    DateTime @default(now())

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@map("registros_auditoria")
}

// ─── FASE 6: NOTIFICAÇÕES ─────────────────────────────────────────────────────

model Notificacao {
  id         String    @id @default(cuid())
  empresa_id String
  usuario_id String?
  tipo       String
  titulo     String
  mensagem   String?
  lida       Boolean   @default(false)
  lida_em    DateTime?
  url        String?
  criado_em  DateTime  @default(now())

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}

// ─── FASE 7: FATURAMENTO ──────────────────────────────────────────────────────

enum StatusNota {
  PENDENTE
  EMITIDA
  PAGA
  CANCELADA
}

model NotaFiscal {
  id              String     @id @default(cuid())
  empresa_id      String
  cliente_id      String
  contrato_id     String?
  criado_por      String?
  numero          String?
  competencia     DateTime
  valor           Decimal    @db.Decimal(10, 2)
  descricao       String
  status          StatusNota @default(PENDENTE)
  data_emissao    DateTime?
  data_vencimento DateTime?
  observacoes     String?
  criado_em       DateTime   @default(now())
  atualizado_em   DateTime   @updatedAt

  recebivel_id     String?   @unique
  nfsio_id         String?
  asaas_invoice_id String?
  nfse_provider    String?   // 'nfsio' | 'asaas'
  numero_nfse      String?
  codigo_servico   String?
  aliquota_iss     Decimal?   @db.Decimal(5, 2)
  pdf_url          String?
  xml_url          String?
  email_enviado    Boolean    @default(false)
  email_enviado_em DateTime?

  empresa   Empresa    @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [cliente_id], references: [id])
  contrato  Contrato?  @relation(fields: [contrato_id], references: [id])
  recebivel Recebivel? @relation(fields: [recebivel_id], references: [id])

  @@map("notas_fiscais")
}

model Boleto {
  id                String   @id @default(cuid())
  empresa_id        String
  recebivel_id      String   @unique
  cliente_id        String?
  asaas_id          String?
  asaas_customer_id String?
  status            String   @default("PENDENTE")
  valor             Decimal  @db.Decimal(12, 2)
  vencimento        DateTime
  linha_digitavel   String?
  codigo_barras     String?
  url_boleto        String?
  url_fatura        String?
  nosso_numero      String?
  criado_em         DateTime @default(now())
  atualizado_em     DateTime @updatedAt

  empresa   Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  recebivel Recebivel @relation(fields: [recebivel_id], references: [id], onDelete: Cascade)
  cliente   Cliente?  @relation(fields: [cliente_id], references: [id])

  @@map("boletos")
}

// ─── FASE 8: DIAGRAMAS & DIAGNÓSTICOS ────────────────────────────────────────

enum TipoDiagnostico {
  SWOT
  CANVAS
  CINCO_W_DOIS_H
  ORGANOGRAMA
  MAPA_PROCESSO
  GANTT
  MAPA_MENTAL
}

model Diagnostico {
  id            String          @id @default(cuid())
  empresa_id    String
  cliente_id    String?
  projeto_id    String?
  criado_por    String?
  tipo          TipoDiagnostico
  titulo        String
  conteudo      Json            @default("{}")
  criado_em     DateTime        @default(now())
  atualizado_em DateTime        @updatedAt

  empresa Empresa  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [cliente_id], references: [id])
  projeto Projeto? @relation(fields: [projeto_id], references: [id])

  @@map("diagnosticos")
}

// ─── PORTAL DO CLIENTE ────────────────────────────────────────────────────────

model TokenPortal {
  id         String    @id @default(cuid())
  cliente_id String
  token      String    @unique @default(cuid())
  email      String
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@map("tokens_portal")
}

// ─── DIAGNÓSTICO DE COLETA (QUESTIONÁRIO PERFIL DO CLIENTE) ───────────────────

enum MomentoDiagnostico {
  PONTO_A
  PONTO_B
  PONTO_C
}

enum StatusAplicacaoDiagnostico {
  PENDENTE
  ENVIADO
  RESPONDIDO
}

model AplicacaoDiagnostico {
  id          String                     @id @default(cuid())
  empresa_id  String
  projeto_id  String
  cliente_id  String?
  criado_por  String?
  momento     MomentoDiagnostico
  status      StatusAplicacaoDiagnostico @default(PENDENTE)
  token       String                     @unique @default(cuid())
  respostas   Json?
  enviado_em  DateTime?
  respondido_em DateTime?
  criado_em   DateTime                   @default(now())
  atualizado_em DateTime                 @updatedAt

  empresa Empresa  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  projeto Projeto  @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [cliente_id], references: [id])

  @@unique([projeto_id, momento])
  @@map("aplicacoes_diagnostico")
}

// ─── FUNIL DE DIAGNÓSTICO PÚBLICO (HOTPAGE) ───────────────────────────────────

model CampanhaDiagnostico {
  id             String   @id @default(cuid())
  empresa_id     String
  slug           String   @unique
  titulo         String   @default("Diagnóstico Empresarial")
  subtitulo      String?
  video_youtube  String?
  url_checkout   String?
  ativo          Boolean  @default(true)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  empresa       Empresa                  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  participantes DiagnosticoParticipante[]

  @@map("campanhas_diagnostico")
}

model DiagnosticoParticipante {
  id                 String    @id @default(cuid())
  campanha_id        String
  lead_id            String?   @unique
  nome               String
  cpf_cnpj           String
  celular            String
  email              String
  celular_verificado Boolean   @default(false)
  otp_code           String?
  otp_expira_em      DateTime?
  respostas          Json?
  pontuacao          Int?
  email_enviado      Boolean   @default(false)
  criado_em          DateTime  @default(now())

  campanha CampanhaDiagnostico @relation(fields: [campanha_id], references: [id], onDelete: Cascade)
  lead     Lead?               @relation(fields: [lead_id], references: [id])

  @@map("diagnostico_participantes")
}

// ─── DIAGNÓSTICO AGRO — TEMPLATES ────────────────────────────────────────────

model DiagnosticoTemplate {
  id                  String   @id @default(cuid())
  empresa_id          String
  cultura             String   // soja | milho | algodao | cana | gado | outro
  nivel               String   // CRITICO | ATENCAO | BOM | EXCELENTE
  titulo              String?
  texto_receita       String?
  texto_custos        String?
  texto_caixa         String?
  texto_recomendacoes String?
  parametros_dre      Json     @default("{}")
  criado_em           DateTime @default(now())
  atualizado_em       DateTime @updatedAt

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id, cultura, nivel])
  @@map("diagnostico_templates")
}

// ─── CAMPANHAS DE CUPOM DE DESCONTO ─────────────────────────────────────────

enum TipoDesconto {
  PERCENTUAL
  FIXO
}

model CampanhaCupom {
  id             String       @id @default(cuid())
  empresa_id     String
  servico_id     String?      // serviço ao qual o cupom se aplica (null = qualquer)
  nome           String
  codigo         String
  tipo_desconto  TipoDesconto @default(PERCENTUAL)
  valor_desconto Decimal      @db.Decimal(10, 2)
  ativo          Boolean      @default(true)
  validade_ate   DateTime?
  usos_maximos   Int?
  usos_count     Int          @default(0)
  criado_em      DateTime     @default(now())
  atualizado_em  DateTime     @updatedAt

  empresa  Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  servico  Servico?  @relation(fields: [servico_id], references: [id])

  @@unique([empresa_id, codigo])
  @@map("campanhas_cupom")
}

// ─── ASSINATURAS (Arato SaaS, O Conselho Agro, Consultoria recorrente) ────────

model Assinatura {
  id                    String   @id @default(cuid())
  empresa_id            String
  cliente_id            String?
  servico_id            String?
  nome_cliente          String
  email_cliente         String?
  telefone_cliente      String?
  canal                 String   // ARATO | CONSELHO_AGRO | CONSULTORIA
  plano                 String?  // ESSENCIAL | GESTAO | PERFORMANCE | NOVO_AGRO | MESA_AGRO | CONSULTORIA_AGRO
  valor                 Decimal  @db.Decimal(10, 2)
  ciclo                 String   @default("MONTHLY") // MONTHLY | YEARLY | WEEKLY
  status                String   @default("ATIVA")   // ATIVA | PAUSADA | CANCELADA | INADIMPLENTE | TRIAL
  asaas_subscription_id String?
  asaas_customer_id     String?
  proximo_vencimento    DateTime?
  data_inicio           DateTime @default(now())
  data_cancelamento     DateTime?
  motivo_cancelamento   String?
  observacoes           String?
  criado_em             DateTime @default(now())
  atualizado_em         DateTime @updatedAt

  empresa Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  cliente Cliente?  @relation(fields: [cliente_id], references: [id])
  servico Servico?  @relation(fields: [servico_id], references: [id])

  @@map("assinaturas")
}
